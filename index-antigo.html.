<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#07111f"><title>Radar FC</title>
<style>
:root{--bg:#07111f;--panel:#101e30;--line:#263950;--txt:#f4f7fb;--muted:#9aabc0;--green:#39df88;--blue:#5aabff}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--txt);font-family:system-ui,-apple-system,Segoe UI,Arial,sans-serif}
main{max-width:1000px;margin:auto;padding:22px 16px 45px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px}.brand{display:flex;align-items:center;gap:10px}.logo{background:var(--green);color:#062415;border-radius:13px;width:42px;height:42px;display:grid;place-items:center;font-size:23px}.brand b{font-size:20px;letter-spacing:1px}.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:1.5px}.pill{font-size:11px;color:#8ef0b7;background:#103323;border:1px solid #225b3d;padding:7px 10px;border-radius:30px}
h1{font-size:clamp(26px,5vw,38px);line-height:1.1;margin:30px 0 7px}.sub{color:var(--muted);font-size:14px;margin:0 0 22px}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:15px}button,input{font:inherit}button{background:#13253a;border:1px solid var(--line);color:var(--txt);padding:10px 14px;border-radius:10px;cursor:pointer}button.primary{background:var(--green);border-color:var(--green);color:#052416;font-weight:800}input{background:#0e1b2b;color:var(--txt);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
#message{color:var(--muted);font-size:12px;margin:12px 0}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.card{background:linear-gradient(145deg,#13243a,#0d1929);border:1px solid var(--line);border-radius:15px;padding:15px}.meta{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font-size:11px}.status{color:#8cebb2}.teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;margin:22px 0;text-align:center}.team{font-weight:750;font-size:14px}.score{font-size:20px;font-weight:900;white-space:nowrap}.time{font-size:10px;color:var(--muted);margin-top:4px}.note{border-top:1px solid var(--line);padding-top:11px;color:var(--muted);font-size:11px;line-height:1.5}.empty{padding:28px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:14px;grid-column:1/-1}.disclaimer{margin-top:20px;border:1px solid #55472a;background:#211d14;color:#e5ca91;padding:13px;border-radius:12px;font-size:12px;line-height:1.5}
@media(max-width:650px){.cards{grid-template-columns:1fr}.pill{font-size:10px}}
</style></head>
<body><main>
<header class="top"><div class="brand"><div class="logo">⚽</div><div><b>RADAR FC</b><small>INTELIGÊNCIA DE FUTEBOL</small></div></div><span class="pill">PAINEL DE JOGOS</span></header>
<h1>Partidas e estatísticas</h1><p class="sub">Consulte jogos por data e acompanhe informações disponíveis na fonte de dados.</p>
<div class="actions"><input type="date" id="date"><button class="primary" id="load">Buscar partidas</button><button id="today">Hoje</button></div>
<div id="message">Carregue as partidas para consultar a fonte conectada.</div>
<section class="cards" id="cards"><div class="empty">As partidas aparecerão aqui.</div></section>
<div class="disclaimer"><b>Uso informativo:</b> o Radar FC apresenta placares e estatísticas. Não oferece palpites de apostas nem garante resultados. Nesta etapa, a API fornece partidas e placares conforme a cobertura e o plano contratado; estatísticas avançadas e eventos ao vivo podem não estar disponíveis.</div>
</main>
<script>
const dateInput=document.getElementById('date'), msg=document.getElementById('message'), cards=document.getElementById('cards');
const today=new Date(); const localDate=new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().slice(0,10);dateInput.value=localDate;
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function statusLabel(s){return ({IN_PLAY:'EM ANDAMENTO',LIVE:'AO VIVO',PAUSED:'INTERVALO',FINISHED:'ENCERRADO',SCHEDULED:'AGENDADO',TIMED:'AGENDADO',POSTPONED:'ADIADO',CANCELLED:'CANCELADO'}[s]||s||'—');}
function clock(iso){return new Date(iso).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});}
async function load(){
 const date=dateInput.value||localDate;msg.textContent='Consultando partidas...';cards.innerHTML='';
 try{
  const r=await fetch(`/api/matches?date=${encodeURIComponent(date)}`), data=await r.json();
  if(!r.ok)throw new Error(data.message||'Erro ao consultar dados.');
  if(!data.matches.length){cards.innerHTML='<div class="empty">Nenhuma partida encontrada para esta data na cobertura da fonte.</div>';msg.textContent='Consulta concluída • 0 partidas';return;}
  cards.innerHTML=data.matches.map(m=>{
   const score=m.homeScore==null?'—':m.homeScore, away=m.awayScore==null?'—':m.awayScore;
   const time=m.minute?`${m.minute}'`:clock(m.utcDate);
   return `<article class="card"><div class="meta"><span>${esc(m.area)} • ${esc(m.competition)}</span><span class="status">${esc(statusLabel(m.status))}</span></div><div class="teams"><div class="team">${esc(m.homeTeam)}</div><div><div class="score">${score} — ${away}</div><div class="time">${esc(time)}</div></div><div class="team">${esc(m.awayTeam)}</div></div><div class="note">Dados fornecidos pela API. A disponibilidade de placar e minuto depende da competição e do plano da fonte.</div></article>`;
  }).join('');
  msg.textContent=`Consulta concluída • ${data.count} partida(s)`;
 }catch(e){cards.innerHTML='<div class="empty">Não foi possível carregar os jogos.</div>';msg.textContent=e.message+' Verifique se o servidor está ativo e se o token foi configurado.';}
}
document.getElementById('load').addEventListener('click',load);
document.getElementById('today').addEventListener('click',()=>{dateInput.value=localDate;load();});
</script></body></html>
